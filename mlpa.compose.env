# Everything MLPA needs in otari mode, for the mlpa and check services. No
# secrets: these are the rig's fixed local values. OTARI_MASTER_KEY,
# OTARI_SERVICE_KEY and OTARI_GUEST_SERVICE_KEY come from docker-compose.yml.
# Budgets and per-user limits live in otari-config.yml, which Otari enforces.
GATEWAY_BACKEND=otari
OTARI_API_BASE=http://otari:8000
MLPA_ADMIN_KEY=sk-mlpa-admin
MLPA_UI_ACCESS_KEY=sk-mlpa-ui
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=otari
DB_PASSWORD=otari
APP_ATTEST_DB_NAME=app_attest
PORT=8080
# false: verify FxA tokens against production accounts, which is where Firefox signs in.
MLPA_DEBUG=false
MLPA_ENFORCE_SIGNIN_CAP=true
MLPA_MAX_SIGNED_IN_USERS=1000
# Guest tokens (GET /verify/v1/guest), on MLPA's guest key in Otari.
MLPA_GUEST_ENABLED=true
MLPA_GUEST_TOKEN_SIGNING_SECRET=pilot-guest-signing-secret
MLPA_ENFORCE_GUEST_CAP=true
MLPA_MAX_GUESTS=1000
ENABLE_TRAFFIC_CONTRACT_ENFORCEMENT=false
MLPA_EXPERIMENTATION_AUTHORIZATION_TOKEN=pilot-dev-token
# Load tests send Otari's load-test key in litellm-virtual-key (otari-config.yml).
ALLOW_CUSTOM_VIRTUAL_KEY=true
