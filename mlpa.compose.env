# Everything MLPA needs in otari mode, for the mlpa and mlpa-init services, and
# for `./run.sh check` on the host. No secrets: these are the rig's fixed local
# values. OTARI_MASTER_KEY comes from docker-compose.yml, and OTARI_SERVICE_KEY
# from otari_provision.py on each `up`.
GATEWAY_BACKEND=otari
OTARI_API_BASE=http://otari:8000
MASTER_KEY=sk-mlpa-admin
MLPA_UI_ACCESS_KEY=sk-mlpa-ui
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=otari
DB_PASSWORD=otari
APP_ATTEST_DB_NAME=app_attest
PORT=8080
# false: verify FxA tokens against production accounts, which is where Firefox signs in.
MLPA_DEBUG=false
MLPA_ENFORCE_SIGNIN_CAP=true
MLPA_MAX_SIGNED_IN_USERS=1000
ENABLE_TRAFFIC_CONTRACT_ENFORCEMENT=false
MLPA_EXPERIMENTATION_AUTHORIZATION_TOKEN=pilot-dev-token
# A budget too small for any request, for check.py's budget refusal ({error: 1}).
# On mochi-dev, which neither Firefox nor the other checks use, so Firefox's own
# traffic (its LLM telemetry runs on service type telemetry) is never refused.
USER_FEATURE_BUDGET_MOCHI_DEV_MAX_BUDGET=0.000001
# Rig override, not production's value: MLPA's default per-user TPM is 2,000, and
# a Smart Window chat with page context alone is 2k-10k prompt tokens, so the
# browser was refused ("Too many messages") after one message. RPM and the dollar
# budgets keep MLPA's defaults, so the limit checks still apply.
USER_FEATURE_BUDGET_AI_TPM_LIMIT=100000
USER_FEATURE_BUDGET_MEMORIES_TPM_LIMIT=100000
USER_FEATURE_BUDGET_SW_ANSWER_TPM_LIMIT=100000
USER_FEATURE_BUDGET_AGENT_TPM_LIMIT=100000
# The global budget (error code 10): a daily ceiling in USD on MLPA's service key,
# pooling every end user, reset at UTC midnight. check.py lowers it for a moment.
OTARI_GLOBAL_MAX_BUDGET=100
